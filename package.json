{
  "name": "pixel-peep",
  "version": "0.1.0",
  "description": "Сравнение кодеков изображений глазами: два варианта одного кадра, точный зум, flip-тест.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "test:e2e": "playwright test",
    "smoke": "playwright test e2e/smoke.spec.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mozgsml/pixel-peep.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/mozgsml/pixel-peep/issues"
  },
  "homepage": "https://github.com/mozgsml/pixel-peep#readme",
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@jsquash/avif": "^2.1.1",
    "@jsquash/jpeg": "^1.6.0",
    "@jsquash/jxl": "^1.3.0",
    "@jsquash/oxipng": "^2.3.0",
    "@jsquash/png": "^3.1.1",
    "@jsquash/webp": "^1.5.0",
    "libheif-js": "^1.19.8"
  },
  "private": true,
  "type": "module"
}
